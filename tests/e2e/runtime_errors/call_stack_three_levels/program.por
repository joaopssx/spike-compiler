algoritmo "pilha"
funcao divide(a, b: inteiro): inteiro
inicio
  retorne a div b
fimfuncao
funcao media(total, n: inteiro): inteiro
inicio
  retorne divide(total, n)
fimfuncao
procedimento relatorio(n: inteiro)
inicio
  escreval(media(10, n))
fimprocedimento
inicio
  relatorio(2)
  relatorio(0)
fimalgoritmo
