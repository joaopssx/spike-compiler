algoritmo "contas prontas"
var
  pi : real
inicio
  pi <- 3.14159265358979
  escreval(abs(-12), " ", abs(3.5), " ", abs(-0.25))
  escreval(raiz(2) * raiz(2) > 1.99, " ", raiz(81))
  escreval(pot(2, 10), " ", pot(10, -2))
  escreval(log(1000), " ", log(0.01), " ", arredonda(exp(1) * 1000))
  escreval(arredonda(seno(pi / 2) * 1000), " ", arredonda(cosseno(pi) * 1000), " ", arredonda(tangente(pi / 4) * 1000))
fimalgoritmo
