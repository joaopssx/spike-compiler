algoritmo "aninhado"
var
  linha, coluna : inteiro
inicio
  linha <- 1
  enquanto linha <= 3 faca
    para coluna de 1 ate 3 faca
      se coluna = linha entao
        escreva("x")
      senao
        escreva(".")
      fimse
    fimpara
    escreval()
    linha <- linha + 1
  fimenquanto
fimalgoritmo
