cmake_minimum_required(VERSION 3.16)

if(NOT DEFINED SOURCE_DIR)
    get_filename_component(SOURCE_DIR "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
endif()
set(limit 300)

set(patterns "")
foreach(folder IN ITEMS src include tests runtime cmake)
    foreach(extension IN ITEMS cpp hpp c h)
        list(APPEND patterns "${SOURCE_DIR}/${folder}/*.${extension}")
    endforeach()
endforeach()
file(GLOB_RECURSE files ${patterns})

set(too_long "")
list(LENGTH files checked)
foreach(path IN LISTS files)
    file(READ "${path}" content)
    string(LENGTH "${content}" with_breaks)
    string(REPLACE "\n" "" without_breaks "${content}")
    string(LENGTH "${without_breaks}" rest)
    math(EXPR lines "${with_breaks} - ${rest}")
    if(NOT content MATCHES "\n$" AND NOT content STREQUAL "")
        math(EXPR lines "${lines} + 1")
    endif()
    if(lines GREATER limit)
        file(RELATIVE_PATH shown "${SOURCE_DIR}" "${path}")
        string(APPEND too_long "  ${shown}: ${lines} lines\n")
    endif()
endforeach()

if(NOT too_long STREQUAL "")
    message(FATAL_ERROR "files over ${limit} lines:\n${too_long}")
endif()
message(STATUS "${checked} files checked, none over ${limit} lines")
