cmake_minimum_required(VERSION 3.16)

if(NOT DEFINED VERSION)
    message(FATAL_ERROR
        "usage: cmake -DVERSION=0.2.0 [-DCHANGELOG=CHANGELOG.md] [-DOUTPUT=notes.md] -P extract_changelog.cmake")
endif()
if(NOT DEFINED CHANGELOG)
    get_filename_component(CHANGELOG "${CMAKE_CURRENT_LIST_DIR}/../CHANGELOG.md" ABSOLUTE)
endif()

file(READ "${CHANGELOG}" text)
string(REPLACE "\r\n" "\n" text "${text}")
set(text "\n${text}")

string(FIND "${text}" "\n## [${VERSION}]" start)
if(start EQUAL -1)
    message(FATAL_ERROR "CHANGELOG.md has no '## [${VERSION}]' section")
endif()
math(EXPR start "${start} + 1")
string(SUBSTRING "${text}" ${start} -1 section)
string(FIND "${section}" "\n" heading_end)
math(EXPR heading_end "${heading_end} + 1")
string(SUBSTRING "${section}" ${heading_end} -1 section)
string(FIND "${section}" "\n## [" next)
if(NOT next EQUAL -1)
    string(SUBSTRING "${section}" 0 ${next} section)
endif()
string(STRIP "${section}" section)
string(REGEX REPLACE "(\n\\[[^\n]*\\]: [^\n]*)+$" "" section "${section}")
string(STRIP "${section}" section)
if(section STREQUAL "")
    message(FATAL_ERROR "the '## [${VERSION}]' section of CHANGELOG.md is empty")
endif()

if(DEFINED OUTPUT)
    file(WRITE "${OUTPUT}" "${section}\n")
else()
    execute_process(COMMAND "${CMAKE_COMMAND}" -E echo "${section}")
endif()
