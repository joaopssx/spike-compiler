// Mostra div, mod e potência com seus resultados.
algoritmo "operadores"
inicio
  escreval("7 div 2 = ", 7 div 2)
  escreval("-7 div 2 = ", -7 div 2)
  escreval("7 mod 3 = ", 7 mod 3)
  escreval("-7 mod 3 = ", -7 mod 3)
  escreval("7 mod -3 = ", 7 mod -3)
  escreval("2 ^ 10 = ", 2 ^ 10)
  escreval("2 ^ -1 = ", 2 ^ -1)
  escreval("-2 ^ 2 = ", -2 ^ 2)
  escreval("2 ^ 3 ^ 2 = ", 2 ^ 3 ^ 2)
  escreval("10 div 3 * 3 + 10 mod 3 = ", 10 div 3 * 3 + 10 mod 3)
fimalgoritmo
